{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src"],
  // The sandbox is a demo host, not part of the published surface. Its .d.ts
  // files referenced dev-only packages (axios) that consumers do not install.
  // Tests are excluded for the same reason — nothing published should carry them.
  "exclude": [
    "src/app",
    "src/main.tsx",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
