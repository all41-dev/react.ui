{
  "name": "@all41-dev/react.ui",
  "type": "module",
  "description": "React UI component library with DataGrid, Tooltip, and Toast components",
  "main": "./dist/react-ui.cjs",
  "module": "./dist/react-ui.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/all41-dev/react.ui.git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all41-dev/react.ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-ui.js",
      "require": "./dist/react-ui.cjs"
    },
    "./styles": {
      "types": "./dist/react.ui.css.d.ts",
      "default": "./dist/react.ui.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.build.json && vite build --mode lib && echo declare const _default: void; export default _default; > dist/react.ui.css.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "preversion": "npm run build:lib --prod",
    "postversion": "git push && git push --tags && npm publish"
  },
  "dependencies": {
    "lucide-react": "^1.28.0"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.64.0",
    "react-tooltip": "^5.29.1 || ^6.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-tooltip": "^6.0.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "version": "0.1.1"
}
